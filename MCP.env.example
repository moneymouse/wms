# Add these values to BK.env (or PRE_BK.env) for both Flask and the MCP service.
# Local Compose development/testing reads them from the shell or Compose .env.
# Set the real HTTPS origin and the exact public MCP endpoint, without trailing slash.
OAUTH_ISSUER_URL=https://wms.example.com
MCP_PUBLIC_URL=https://wms.example.com/mcp

# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the actual value. Empty configuration keeps OAuth unavailable.
OAUTH_SESSION_SECRET=

# Comma-separated exact host[:port] / origins. Empty values use the public URL.
MCP_ALLOWED_HOSTS=wms.example.com
MCP_ALLOWED_ORIGINS=https://wms.example.com

# Only loopback development may use HTTP; production remains HTTPS.
OAUTH_ALLOW_LOCAL_HTTP=false
