# Copy to env.toml and fill the real credentials on the running server.
17track_token = ""
17track_endpoint = "https://api.17track.net/track/v2.2"

# Shared by order-address parsing and paper-intake recognition.
# All DeepSeek settings are read from this file on each request.
# An empty API key disables DeepSeek recognition.
deepseek_api_key = ""
deepseek_base_url = "https://api.deepseek.com"
deepseek_model = "deepseek-flash"
deepseek_timeout_seconds = 90

# Order-address city/region lookup only; read on each request.
# Missing/empty key keeps the extracted fields and adds a review warning.
# The Postal Code API request has a fixed 10-second timeout.
api_ninjas_api_key = ""
