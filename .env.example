# WMS后端环境变量配置
# 复制此文件为 .env 并根据需要修改

# Flask应用配置
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# 数据库配置
DATABASE_URL=mysql+pymysql://wms_user:wms_password@localhost:3306/wms_db?charset=utf8mb4
DB_HOST=localhost
DB_PORT=3306
DB_USER=wms_user
DB_PASSWORD=wms_password
DB_NAME=wms_db

# JWT密钥配置
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRE_SECONDS=604800

# 安全配置
SECRET_KEY=your-flask-secret-key-change-in-production
BCRYPT_LOG_ROUNDS=12

# CORS配置 (开发模式)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# 日志配置
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# 文件上传配置
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB