# WMS后端环境变量配置
# 复制此文件为 .env 并根据需要修改

# Flask应用配置
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# 数据库配置
DATABASE_URL=mysql+pymysql://wms_user:wms_password@localhost:3306/wms_db?charset=utf8mb4
DB_HOST=localhost
DB_PORT=3306
DB_USER=wms_user
DB_PASSWORD=wms_password
DB_NAME=wms_db

# JWT密钥配置
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRE_SECONDS=604800

# 安全配置
SECRET_KEY=your-flask-secret-key-change-in-production
BCRYPT_LOG_ROUNDS=12

# CORS配置 (开发模式)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# 日志配置
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# 文件上传配置
UPLOAD_FOLDER=uploads
# 私有纸单照片目录；Docker 默认位于已有 /app/uploads 持久化挂载中。
# PAPER_PHOTO_ROOT=/app/uploads/paper_intakes
# 三阶段旧照片迁移的导出清单；未设置时使用照片目录内的默认清单。
# PAPER_PHOTO_MANIFEST=/app/uploads/paper_intakes/.photo-migration-manifest.json
MAX_CONTENT_LENGTH=26214400  # 25MB: 24MB纸单照片及multipart开销

# 纸单回传：DeepSeek 图片识别（只生成待核对候选，不自动入库）
# DeepSeek 只读取后端 env.toml 顶层的 deepseek_api_key、deepseek_base_url、
# deepseek_model 和 deepseek_timeout_seconds；每次调用重新读取，不读取环境变量或 .env。
# 空密钥会禁用识别/解析；其余缺失项使用默认值，配置格式见 env.toml.example。
# 新部署先复制 env.toml.example 为 env.toml；Compose 运行时只读挂载，密钥不打包进镜像。

# 仅无alembic_version的旧库需要填写经过核验的实际schema版本；不能填写head。
# ALEMBIC_BASELINE_REVISION=
