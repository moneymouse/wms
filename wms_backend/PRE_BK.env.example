# Copy to PRE_BK.env on the server. Never commit the real values.
DATABASE_URL=mysql+pymysql://wms_pre_app:replace-with-a-long-random-password@mysql:3306/wms_pre?charset=utf8mb4
FLASK_ENV=production

# Paper-intake recognition only proposes a draft; reviewers confirm inventory.
# Copy env.toml.example to env.toml and set the top-level deepseek_api_key,
# deepseek_base_url, deepseek_model and deepseek_timeout_seconds there.
# Compose mounts env.toml read-only at runtime; credentials are not baked into the image.
# DeepSeek reads env.toml on each call, without environment-variable/.env fallback.
# Missing fields use defaults; an empty/missing key disables recognition/address parsing.

# Only for a verified legacy schema without an alembic_version table.
# ALEMBIC_BASELINE_REVISION=
